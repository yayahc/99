<?xml version="1.0" encoding="utf-8"?>
<!-- Icon for the Android 12+ system splash screen. The platform hands the
     drawable a 240dp canvas and masks anything outside the inner circle, so the
     logo is inset to 108dp to stay well inside it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="108dp"
        android:height="108dp"
        android:gravity="center"
        android:drawable="@drawable/splash_logo" />
</layer-list>
